#version 450
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable

// Exact Wave64 alignment for AMD Vega 10 (GCN5 / gfx900)
layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer BufferInA {
    float dataA[];
};

layout(std430, binding = 1) readonly buffer BufferInB {
    float dataB[];
};

layout(std430, binding = 2) writeonly buffer BufferOut {
    float dataOut[];
};

void main() {
    uint gid = gl_GlobalInvocationID.x;
    
    float a = dataA[gid];
    float b = dataB[gid];
    
    // Wave64 parallel warp reduction
    float prod = a * b;
    float waveSum = subgroupAdd(prod);
    
    // Quantum activation function: non-linear tensor contraction
    float activated = tanh(prod + (waveSum * 0.015625)); // 1/64 factor
    
    dataOut[gid] = activated;
}
